// AVTO-PRO-SYSTEM — Prisma schema (PostgreSQL)
// Based on TZ.md section 4) MA'LUMOTLAR BAZASI

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  boss
  master
  driver
}

enum OrderStatus {
  draft
  waiting_confirmation
  waiting_master_work_start
  broadcasted
  accepted
  received_by_driver
  waiting_master_delivery_confirmation
  delivered_by_driver
  received_by_master
  working
  waiting_customer_confirmation
  completed
  cancelled
}

enum PaymentType {
  cash
  corporate_debt
}

enum OrderItemType {
  product
  service
  manual_product
}

// ─────────────────────────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  phone        String?
  address      String?
  is_active    Boolean   @default(true)
  is_blocked   Boolean   @default(false)
  plan_expires DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  users             User[]
  orders            Order[]
  organizations     Organization[]
  vehicles          Vehicle[]
  services          Service[]
  products          Product[]
  suppliers         Supplier[]
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  fullname          String
  phone             String    @unique
  username          String?
  login             String    @unique
  password_hash     String
  role              Role
  tg_id             String?   @unique
  percent_rate      Decimal   @db.Decimal(10, 4)
  balance           Decimal   @default(0) @db.Decimal(12, 2)
  is_active         Boolean   @default(true)
  pin_code_hash     String?
  is_authenticated     Boolean   @default(false)
  last_authenticated_at DateTime? @db.Timestamptz(6)
  locked_until         DateTime? @db.Timestamptz(6)
  pin_fail_count       Int       @default(0)
  tenant_id          String?   @db.Uuid
  is_super_admin     Boolean   @default(false)

  tenant              Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: SetNull)
  ordersAsMaster      Order[]  @relation("OrderMaster")
  ordersAsDriver     Order[]  @relation("OrderDriver")
  orderEvents        OrderEvent[]
  transactions       Transaction[]
  productPriceHistories ProductPriceHistory[]
  auditLogs          AuditLog[]
}

model Transaction {
  id        String   @id @default(uuid()) @db.Uuid
  order_id  String   @db.Uuid
  user_id   String   @db.Uuid
  amount    Decimal  @db.Decimal(12, 2) // amount in UZS (e.g. 30_000 for delivery fee)
  type      String   // e.g. 'delivery_fee'
  created_at DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@unique([order_id, user_id, type])
  @@index([user_id])
}

model Organization {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  contact_person String
  phone          String
  payment_type   PaymentType
  balance_due    Decimal      @default(0) @db.Decimal(12, 2)
  is_active      Boolean      @default(true)
  tenant_id      String?      @db.Uuid

  tenant   Tenant?   @relation(fields: [tenant_id], references: [id], onDelete: SetNull)
  vehicles Vehicle[]
  orders   Order[]
}

model Vehicle {
  id           String   @id @default(uuid()) @db.Uuid
  org_id       String   @db.Uuid
  plate_number String
  model        String
  year         Int?     // Optional: vehicle year (1900-2030)
  color        String?  @db.VarChar(50) // Optional: vehicle color
  vin          String?  @db.VarChar(50) // Optional: vehicle VIN
  is_active    Boolean  @default(true)
  tenant_id    String?  @db.Uuid

  tenant       Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [org_id], references: [id], onDelete: Restrict)
  orders       Order[]
}

model Supplier {
  id           String   @id @default(uuid()) @db.Uuid
  fullname     String
  phone        String?
  bank_account String?
  note         String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  tenant_id    String?  @db.Uuid

  tenant    Tenant?           @relation(fields: [tenant_id], references: [id], onDelete: SetNull)
  products  Product[]         @relation("ProductSupplier")
  purchases SupplierPurchase[]
  payments  SupplierPayment[]
}

model SupplierPurchase {
  id          String   @id @default(uuid()) @db.Uuid
  supplier_id String   @db.Uuid
  product_id  String   @db.Uuid
  quantity    Int
  unit_cost   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([supplier_id])
  @@index([product_id])
}

model SupplierPayment {
  id          String   @id @default(uuid()) @db.Uuid
  supplier_id String   @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  note        String?

  supplier Supplier @relation(fields: [supplier_id], references: [id], onDelete: Restrict)

  @@index([supplier_id])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  cost_price  Decimal  @db.Decimal(12, 2)
  sale_price  Decimal  @db.Decimal(12, 2)
  stock_count Int
  min_limit   Int
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  tenant_id   String?  @db.Uuid
  supplier_id String?  @db.Uuid

  tenant         Tenant?              @relation(fields: [tenant_id], references: [id], onDelete: SetNull)
  supplier       Supplier?           @relation("ProductSupplier", fields: [supplier_id], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  priceHistories ProductPriceHistory[]
  supplierPurchases SupplierPurchase[]

  @@index([supplier_id])
}

model ProductPriceHistory {
  id               String   @id @default(uuid()) @db.Uuid
  product_id       String   @db.Uuid
  cost_price       Decimal  @db.Decimal(12, 2)
  sale_price       Decimal  @db.Decimal(12, 2)
  changed_by_id    String?  @db.Uuid
  note             String?
  created_at       DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changed_by_id], references: [id], onDelete: SetNull)
}

model Service {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  price     Decimal  @db.Decimal(12, 2)
  is_active Boolean  @default(true)
  tenant_id String?  @db.Uuid

  tenant     Tenant? @relation(fields: [tenant_id], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
}

model Order {
  id                 String       @id @default(uuid()) @db.Uuid
  master_id          String       @db.Uuid
  driver_id          String?      @db.Uuid
  organization_id    String?      @db.Uuid
  vehicle_id         String?      @db.Uuid
  client_name        String
  client_phone       String
  car_number         String
  car_model          String?
  car_photo_url      String?
  lat                Decimal?     @db.Decimal(10, 7)
  lng                Decimal?     @db.Decimal(10, 7)
  delivery_needed    Boolean
  status             OrderStatus
  total_amount       Decimal      @db.Decimal(12, 2)
  confirm_token      String?      @db.Uuid
  created_at         DateTime     @default(now())
  completed_at       DateTime?
  tenant_id          String?      @db.Uuid

  tenant       Tenant?        @relation(fields: [tenant_id], references: [id], onDelete: SetNull)
  master       User           @relation("OrderMaster", fields: [master_id], references: [id], onDelete: Restrict)
  driver       User?          @relation("OrderDriver", fields: [driver_id], references: [id], onDelete: SetNull)
  organization Organization?  @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  vehicle      Vehicle?       @relation(fields: [vehicle_id], references: [id], onDelete: SetNull)
  orderItems   OrderItem[]
  orderEvents  OrderEvent[]
  transactions Transaction[]
}

model OrderItem {
  id            String        @id @default(uuid()) @db.Uuid
  order_id      String        @db.Uuid
  item_type     OrderItemType
  product_id    String?       @db.Uuid
  service_id    String?       @db.Uuid
  item_name     String?
  quantity      Int
  price_at_time Decimal       @db.Decimal(12, 2)

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [service_id], references: [id], onDelete: SetNull)
}

model OrderEvent {
  id             String   @id @default(uuid()) @db.Uuid
  order_id       String   @db.Uuid
  actor_user_id  String?  @db.Uuid
  event_type     String
  payload        Json?
  created_at     DateTime @default(now())

  order  Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  actor  User? @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String?  @db.Uuid
  action     String
  entity     String
  entity_id  String?  @db.Uuid
  meta       Json?
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([entity, entity_id])
}
